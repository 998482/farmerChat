# LLM providers: Groq primary, Gemini fallback
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_key_here

# Chroma persistence path (inside container this stays as-is; docker-compose mounts a volume here)
CHROMA_DB_DIR=./chroma_db
CHROMA_COLLECTION_NAME=krishi_agent_docs

# Where raw ICAR/KVK PDFs live before ingestion
DOCS_SOURCE_DIR=./data/icar_kvk_docs

# Embedding model (runs locally on your machine, free, no API key needed).
# Multilingual because farmer queries are Hindi but ICAR/KVK PDFs are mostly English.
# Low-RAM machine? Swap to: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=intfloat/multilingual-e5-large

RETRIEVER_TOP_K=4
MAX_LLM_RETRIES=2
